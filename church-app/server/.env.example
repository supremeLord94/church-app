PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/church
# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Timezone used for "today" when a class or new person has no date (set to your church's timezone)
TZ=America/Los_Angeles
# Activity log: days to keep entries (default 365)
ACTIVITY_RETENTION_DAYS=365
# Set to 1 when the API runs behind a proxy (Render, Railway, nginx) so the log shows each person's real IP
# TRUST_PROXY=1   (default is 'loopback', which is right for local development)
